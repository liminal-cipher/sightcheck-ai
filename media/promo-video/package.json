{
  "name": "sightcheck-promo-video",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "시야체크 홍보 영상 — HTML 타임라인을 프레임 단위로 캡처해 MP4로 렌더링",
  "scripts": {
    "capture-ui": "node scripts/capture-ui.mjs",
    "preview": "node scripts/server.mjs",
    "audio": "python3 scripts/audio.py",
    "stills": "node scripts/stills.mjs out/stills",
    "render": "node scripts/render.mjs --fps 60 --crf 18 --out out/sightcheck-promo.mp4",
    "render:draft": "node scripts/render.mjs --fps 30 --crf 22 --out out/draft.mp4"
  },
  "devDependencies": {
    "@fontsource-variable/noto-sans-kr": "^5.3.0",
    "playwright-core": "1.56.1",
    "pretendard": "1.3.9"
  }
}
